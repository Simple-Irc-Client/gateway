[Unit]
Description=Simple IRC Client Gateway
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=sic-gateway
Image=docker.io/simpleircclient/simple-irc-gateway:latest
ReadOnly=true
Memory=512m
PodmanArgs=--cpus 1
PublishPort=8667:8667
PublishPort=113:8113
Environment=PORT=8667
Environment=HOST=0.0.0.0
Environment=PATH_PREFIX=/webirc
Environment=ALLOWED_ORIGINS=https://app.simpleircclient.com
Environment=IDENTD_ENABLED=true
Environment=IDENTD_PORT=8113
HealthCmd=node -e "Promise.all([fetch('http://localhost:8667').then(r=>{if(!r.ok)throw r.status}),new Promise((res,rej)=>{const s=require('net').connect(8113,'localhost',()=>{s.destroy();res()});s.on('error',rej);s.setTimeout(5000,()=>{s.destroy();rej('timeout')})})]).catch(()=>process.exit(1))"
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=5s

[Install]
WantedBy=multi-user.target
