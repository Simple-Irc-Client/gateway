{
  "name": "sic-gateway",
  "description": "Simple IRC Client WebSocket Gateway",
  "version": "1.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "start": "node --import tsx ./server.ts",
    "dev": "tsx watch ./server.ts",
    "build": "tsc && node build.js",
    "lint": "tsc --noEmit && eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2",
    "ws": "^8.21.0"
  }
}
